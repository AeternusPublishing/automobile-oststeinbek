<figure class="v8-figure">{% if picture.crop %}<div class="v8-portrait"><img src="{{ picture.file | url }}" alt="Yoshihiko Dohi, zeitgenössisches Porträt" loading="lazy"></div>{% else %}<img src="{{ picture.file | url }}" alt="{{ picture.caption }}" loading="lazy">{% endif %}<figcaption><span class="v8-rights">{{ picture.rights }}</span><p>{{ picture.caption }}</p><small>{{ picture.credit }} · <a href="{{ picture.source }}" target="_blank" rel="noopener">Archivquelle ↗</a></small></figcaption></figure>